# udev rules for Teensy boards (USB vendor 16c0), so the MIDI Toolbox app can talk to the unit and
# program it without administrator rights. Install once (the app's Device tab shows the exact commands):
#
#   sudo cp 00-teensy.rules /etc/udev/rules.d/00-teensy.rules
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#
# then unplug the unit and plug it in again.
#
# These do the same job as the rules published by PJRC, the maker of the Teensy
# (https://www.pjrc.com/teensy/00-teensy.rules).

# Stop ModemManager from grabbing the unit's serial port and holding it for several seconds
ATTRS{idVendor}=="16c0", ATTRS{idProduct}=="04[789B]?", ENV{ID_MM_DEVICE_IGNORE}="1"
ATTRS{idVendor}=="16c0", ATTRS{idProduct}=="04[789A]?", ENV{MTP_NO_PROBE}="1"

# Let any user open the Teensy: running firmware, serial port and bootloader
SUBSYSTEMS=="usb", ATTRS{idVendor}=="16c0", ATTRS{idProduct}=="04[789ABCD]?", MODE:="0666"
KERNEL=="ttyACM*", ATTRS{idVendor}=="16c0", ATTRS{idProduct}=="04[789B]?", MODE:="0666"
